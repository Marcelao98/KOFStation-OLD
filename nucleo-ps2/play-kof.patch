+// KOFstation: o app manda os botões (máscara do libretro) e os 4 eixos (int8 cada, num uint32) a cada quadro
+// libretro: B Y Select Start Cima Baixo Esq Dir A X L R L2 R2 L3 R3 -> botões do PS2
+static const PS2::CControllerInfo::BUTTON KOF_BOTOES[16] = {
+	PS2::CControllerInfo::CROSS, PS2::CControllerInfo::SQUARE, PS2::CControllerInfo::SELECT, PS2::CControllerInfo::START,
+	PS2::CControllerInfo::DPAD_UP, PS2::CControllerInfo::DPAD_DOWN, PS2::CControllerInfo::DPAD_LEFT, PS2::CControllerInfo::DPAD_RIGHT,
+	PS2::CControllerInfo::CIRCLE, PS2::CControllerInfo::TRIANGLE, PS2::CControllerInfo::L1, PS2::CControllerInfo::R1,
+	PS2::CControllerInfo::L2, PS2::CControllerInfo::R2, PS2::CControllerInfo::L3, PS2::CControllerInfo::R3};
+static const PS2::CControllerInfo::BUTTON KOF_EIXOS[4] = {
+	PS2::CControllerInfo::ANALOG_LEFT_X, PS2::CControllerInfo::ANALOG_LEFT_Y,
+	PS2::CControllerInfo::ANALOG_RIGHT_X, PS2::CControllerInfo::ANALOG_RIGHT_Y};
+static uint32 g_kofBotoes = 0, g_kofEixos = 0;
+
+static void kofLigarControle()
+{
+	auto padHandler = static_cast<CPH_GenericInput*>(g_virtualMachine->GetPadHandler());
+	auto& bindingManager = padHandler->GetBindingManager();
+	for(int i = 0; i < 16; i++)
+		bindingManager.SetSimpleBinding(0, KOF_BOTOES[i], CInputProviderEmscripten::MakeRawTarget(0x10000 + i));
+	for(int i = 0; i < 4; i++)
+	{
+		bindingManager.SetSimpleBinding(0, KOF_EIXOS[i], CInputProviderEmscripten::MakeRawTarget(0x10100 + i));
+		g_inputProvider->SetRaw(0x10100 + i, 0x80);
+	}
+}
+
+void setPad(uint32 botoes, uint32 eixos)
+{
+	uint32 mudou = botoes ^ g_kofBotoes;
+	for(int i = 0; i < 16; i++)
+		if(mudou & (1 << i)) g_inputProvider->SetRaw(0x10000 + i, (botoes >> i) & 1);
+	if(eixos != g_kofEixos)
+		for(int i = 0; i < 4; i++)
+			g_inputProvider->SetRaw(0x10100 + i, static_cast<uint8>(static_cast<int8>(eixos >> (i * 8)) + 0x80));
+	g_kofBotoes = botoes;
+	g_kofEixos = eixos;
+}
+
+// pausar/continuar sem esperar (o Pause/Resume normal espera a thread da máquina, que pode estar esperando esta linha
+// ler um pedaço do DVD: as duas travariam)
+void pauseVm()
+{
+	g_virtualMachine->PauseAsync();
+}
+
+void resumeVm()
+{
+	g_virtualMachine->KofResume();
+}
+
+int vmStatus()
+{
+	return g_virtualMachine->GetStatus();
+}
+
+// estado: roda na thread da máquina; o JS espera o 1 (ok) ou 2 (falhou) em estadoPronto()
+static std::atomic<int> g_kofEstado{0};
+void saveState(std::string path)
+{
+	g_kofEstado = 0;
+	g_virtualMachine->KofCall([path]() { g_kofEstado = g_virtualMachine->KofSaveState(path) ? 1 : 2; });
+}
+
+void loadState(std::string path)
+{
+	g_kofEstado = 0;
+	g_virtualMachine->KofCall([path]() { g_kofEstado = g_virtualMachine->KofLoadState(path) ? 1 : 2; });
+}
+
+int estadoPronto()
+{
+	return g_kofEstado;
+}
+
+// volume do app (0..1); o OpenAL do emscripten roda na linha principal, de onde o JS chama isto
+void setVolume(float v)
+{
+	alListenerf(AL_GAIN, v);
+}
